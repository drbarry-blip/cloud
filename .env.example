# Copy to apps/web/.env.local for local development. Everything is optional
# locally: missing settings switch that feature to a safe fallback.
# In production, set these in your host's secret manager, not in a file.

# Public URL of the site (used in email links).
SITE_URL=http://localhost:3000

# Required in production: a long random string used to sign email links.
# Generate one with: openssl rand -hex 32
APP_SECRET=

# Required for marketing email (CAN-SPAM): your business postal address.
MAILING_ADDRESS=

# --- Claude (Reply Checker AI review). Without both, the checker runs rules-only. ---
ANTHROPIC_API_KEY=
# The Claude model ID to use. Pick the current top-tier model from Anthropic's
# models page (https://docs.claude.com/en/docs/about-claude/models).
ANTHROPIC_MODEL=
# Optional: low | medium | high. Leave blank for the model's default.
ANTHROPIC_EFFORT=

# --- Google (Visibility Score). Without a key, the tool shows "not switched on yet". ---
# Enable "Places API (New)" and "PageSpeed Insights API"; restrict the key to those APIs.
GOOGLE_MAPS_API_KEY=
# Optional separate key for PageSpeed (defaults to GOOGLE_MAPS_API_KEY).
PAGESPEED_API_KEY=

# --- Cloudflare Turnstile (bot protection on the free tools). ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Database. Without it, data is kept in memory and lost on restart. ---
DATABASE_URL=

# --- Email via Resend. Without these, emails are printed to the server log. ---
RESEND_API_KEY=
EMAIL_FROM="Clinic Growth Suite <hello@example.com>"
EMAIL_REPLY_TO=

# Secret for the hourly nurture-email job (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Optional privacy-friendly analytics (Plausible). Never loaded on the Reply Checker.
PLAUSIBLE_DOMAIN=

# How many proxies append to X-Forwarded-For in front of the app (for rate limiting).
# Cloud Run alone: 1. Behind a Google HTTPS load balancer: 2.
TRUSTED_PROXY_COUNT=1

# Optional daily limits (defaults shown).
# LIMIT_REPLY_CHECKS_ANON=5
# LIMIT_REPLY_CHECKS_EMAIL=30
# LIMIT_VISIBILITY_PER_IP=5
# LIMIT_VISIBILITY_TOTAL=300
# LIMIT_LEADS_PER_IP=10
