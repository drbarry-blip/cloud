# Copy to apps/web/.env.local for local development. Everything is optional
# locally: missing settings switch that feature to a safe fallback.
# In production, set these in your host's secret manager, not in a file.

# Public URL of the site (used in email links).
SITE_URL=http://localhost:3000

# Required in production: a long random string used to sign email links.
# Generate one with: openssl rand -hex 32
APP_SECRET=

# Required for marketing email (CAN-SPAM): your business postal address.
MAILING_ADDRESS=

# --- Claude (Reply Checker AI review). Without both, the checker runs rules-only. ---
ANTHROPIC_API_KEY=
# The Claude model ID to use. Pick the current top-tier model from Anthropic's
# models page (https://docs.claude.com/en/docs/about-claude/models).
ANTHROPIC_MODEL=
# Optional: low | medium | high. Leave blank for the model's default.
ANTHROPIC_EFFORT=

# --- Google (Visibility Score). Without a key, the tool shows "not switched on yet". ---
# Enable "Places API (New)" and "PageSpeed Insights API"; restrict the key to those APIs.
GOOGLE_MAPS_API_KEY=
# Optional separate key for PageSpeed (defaults to GOOGLE_MAPS_API_KEY).
PAGESPEED_API_KEY=

# --- Cloudflare Turnstile (bot protection on the free tools). ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Database. Without DATABASE_URL, an embedded PGlite database is used (development). ---
DATABASE_URL=
# Where PGlite keeps its files; leave blank to keep data in memory only.
PGLITE_DIR=

# --- Email via Resend. Without these, emails are printed to the server log. ---
RESEND_API_KEY=
EMAIL_FROM="Clinic Growth Suite <hello@example.com>"
EMAIL_REPLY_TO=

# Secret for the scheduled jobs (Authorization: Bearer <CRON_SECRET>):
#   POST /api/cron/nurture hourly, POST /api/cron/shopper every 5 minutes.
CRON_SECRET=

# --- Secret Shopper ---
# Orders are always open in development. In production, set to true to start selling.
SHOPPER_OPEN=
# Stripe Checkout. Without both, development uses a simulated checkout page.
# Webhook endpoint: <SITE_URL>/api/stripe/webhook (events: checkout.session.completed,
# checkout.session.async_payment_succeeded).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required in production: domains we own for persona mailboxes, comma-separated.
# Personal-style domains only; never look-alikes of real email providers.
PERSONA_EMAIL_DOMAINS=
# Staff who can sign in to the admin console (comma-separated emails).
ADMIN_EMAILS=
VA_EMAILS=
# Where alerts about new ops tasks go (defaults to the first admin).
OPS_ALERT_EMAIL=
# Twilio persona numbers (receive-only in v1). Point each number's webhooks at:
#   Voice: <SITE_URL>/api/twilio/voice   Status callback: <SITE_URL>/api/twilio/status
#   Messaging: <SITE_URL>/api/twilio/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Shared secret for the inbound email worker (workers/inbound-email).
INBOUND_EMAIL_SECRET=
# A browser for submitting web forms: a remote Chrome (CDP websocket, e.g. a hosted
# browser service) or a local Chromium binary. Without either, a VA submits forms.
BROWSER_WS_ENDPOINT=
CHROMIUM_PATH=

# Optional privacy-friendly analytics (Plausible). Never loaded on the Reply Checker.
PLAUSIBLE_DOMAIN=

# How many proxies append to X-Forwarded-For in front of the app (for rate limiting).
# Cloud Run alone: 1. Behind a Google HTTPS load balancer: 2.
TRUSTED_PROXY_COUNT=1

# Optional daily limits (defaults shown).
# LIMIT_REPLY_CHECKS_ANON=5
# LIMIT_REPLY_CHECKS_EMAIL=30
# LIMIT_VISIBILITY_PER_IP=5
# LIMIT_VISIBILITY_TOTAL=300
# LIMIT_LEADS_PER_IP=10
